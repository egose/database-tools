# Optional managed backup namespace override
MONGOARCHIVE__BACKUP_PREFIX=mongo-archive/
MONGOUNARCHIVE__BACKUP_PREFIX=mongo-archive/
# Optional restore backend selection when multiple storage backends are configured
MONGOUNARCHIVE__STORAGE_BACKEND=

# Optional PostgreSQL managed backup namespace override. PostgreSQL archives use
# postgres-archive/ by default and are isolated from MongoDB's mongo-archive/.
POSTGRESARCHIVE__BACKUP_PREFIX=postgres-archive/
POSTGRESUNARCHIVE__BACKUP_PREFIX=postgres-archive/
# Optional restore backend selection when multiple storage backends are configured
POSTGRESUNARCHIVE__STORAGE_BACKEND=

# PostgreSQL command-specific variables override POSTGRES__* and unprefixed keys.
POSTGRES__URI=
POSTGRES__DATABASE=
POSTGRES__PASSWORD=

# Optional archive notifications
MONGOARCHIVE__SLACK_WEBHOOK_URL=
MONGOARCHIVE__SLACK_WEBHOOK_PREFIX=[database-tools]
MONGOARCHIVE__SLACK_NOTIFY_ON_FAILURE_ONLY=true

MONGOARCHIVE__SMTP_HOST=
MONGOARCHIVE__SMTP_PORT=587
MONGOARCHIVE__SMTP_USERNAME=
MONGOARCHIVE__SMTP_PASSWORD=
MONGOARCHIVE__SMTP_FROM=
MONGOARCHIVE__SMTP_TO=
MONGOARCHIVE__SMTP_SUBJECT_PREFIX=[database-tools]
MONGOARCHIVE__SMTP_NOTIFY_ON_FAILURE_ONLY=true

MONGOARCHIVE__SES_ENDPOINT=
MONGOARCHIVE__SES_REGION=
MONGOARCHIVE__SES_ACCESS_KEY_ID=
MONGOARCHIVE__SES_SECRET_ACCESS_KEY=
MONGOARCHIVE__SES_FROM=
MONGOARCHIVE__SES_TO=
MONGOARCHIVE__SES_SUBJECT_PREFIX=[database-tools]
MONGOARCHIVE__SES_NOTIFY_ON_FAILURE_ONLY=true
