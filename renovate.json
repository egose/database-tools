{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "docker": {
    "pinDigests": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/release\\.yml$"],
      "matchStrings": [
        "(?<depName>anchore/syft):(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/actions/setup-tools/action\\.yml$"],
      "matchStrings": [
        "add_pinned_plugin mongodb https://github\\.com/junminahn/asdf-mongodb\\.git (?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "junminahn/asdf-mongodb",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/actions/setup-tools/action\\.yml$"],
      "matchStrings": [
        "add_pinned_plugin docker-compose https://github\\.com/egose/asdf-docker-compose\\.git (?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "egose/asdf-docker-compose",
      "datasourceTemplate": "git-refs"
    }
  ]
}
